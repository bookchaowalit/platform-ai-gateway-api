{
  "name": "solo-empire-ai-gateway-service",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone hosted Central AI Gateway (solo-empire.ai-gateway.v1) for Railway.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "esbuild main.ts --bundle --platform=node --format=esm --target=node22 --external:node:sqlite --outfile=dist/server.mjs --legal-comments=none && node -e \"require('fs').mkdirSync('dist/migrations',{recursive:true});require('fs').copyFileSync('../../database/migrations/025_ai_run_telemetry.sql','dist/migrations/025_ai_run_telemetry.sql')\"",
    "start": "node --disable-warning=ExperimentalWarning dist/server.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.1"
  },
  "dependencies": {
    "@sentry/node": "11.4.0"
  }
}
