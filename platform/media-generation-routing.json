{
  "schema_version": "solo-empire.media-generation-routing.v1",
  "updated_at": "2026-11-11",
  "description": "SPEC-003 media generation registry. Rankings, prices and enabled flags change here, never in code. Every model ships disabled with no prices: the owner sets provider_model, prices (from the provider's pricing page, with source and checked_at) and enabled on setup day (SPEC-003 Q1, Q4). openai-image (gpt-image-1.5): each price = the per-image output price from the model page + 0.01 USD prompt allowance (text input 5 USD / 1M tokens x 2,000 tokens), which covers policy.max_prompt_chars=1000 at up to 2 tokens per character (the env cap can only lower it); raise the allowance before raising that cap.",
  "policy": {
    "max_evaluation_age_days": 60,
    "external_privacy_classes": ["public", "internal"],
    "fallback_depth": 0,
    "lease_wait_max_ms": 1800000,
    "job_timeout_ms": 1800000,
    "max_prompt_chars": 1000
  },
  "providers": {
    "openai": {
      "adapter": "openai-images",
      "credential_env": "OPENAI_API_KEY",
      "max_concurrent": 2,
      "max_in_flight": 4,
      "rpm": 20,
      "webhook": false,
      "output_hosts": [],
      "privacy_classes": ["public", "internal"],
      "terms_checked_at": "2026-11-11"
    }
  },
  "models": {
    "openai-image": {
      "provider": "openai",
      "provider_model": "gpt-image-1.5",
      "kind": "image",
      "enabled": true,
      "capabilities": {
        "aspects": ["1:1", "3:2", "2:3"],
        "resolutions": ["draft", "standard", "high"],
        "references": 0,
        "text_in_image": "fair",
        "max_n": 4
      },
      "param_map": {
        "aspect": {
          "1:1": { "size": "1024x1024" },
          "3:2": { "size": "1536x1024" },
          "2:3": { "size": "1024x1536" }
        },
        "resolution": {
          "draft": { "quality": "low" },
          "standard": { "quality": "medium" },
          "high": { "quality": "high" }
        }
      },
      "extra_params": {
        "background": { "type": "string", "values": ["auto", "transparent", "opaque"] }
      },
      "pricing": {
        "unit": "image",
        "cost_source": "registry",
        "cancel_policy": "free",
        "usd": {
          "1:1|draft": 0.019,
          "1:1|standard": 0.044,
          "1:1|high": 0.143,
          "3:2|draft": 0.023,
          "3:2|standard": 0.06,
          "3:2|high": 0.21,
          "2:3|draft": 0.023,
          "2:3|standard": 0.06,
          "2:3|high": 0.21
        },
        "source": "https://developers.openai.com/api/docs/models/gpt-image-1.5",
        "checked_at": "2026-11-11"
      },
      "own_eval": null
    }
  },
  "profiles": {
    "social-square-photo": {
      "kind": "image",
      "defaults": { "aspect": "1:1", "resolution": "standard" },
      "models": ["openai-image"]
    },
    "draft-image": {
      "kind": "image",
      "defaults": { "aspect": "1:1", "resolution": "draft" },
      "models": ["openai-image"]
    }
  }
}
